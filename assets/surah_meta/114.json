{
  "1": {
    "t": "Say, ˹O Prophet,˺ “I seek refuge in the Lord of humankind",
    "tr": "Qul a'oozu birabbin naas"
  },
  "2": {
    "t": "the Master of humankind",
    "tr": "Malikin naas"
  },
  "3": {
    "t": "the God of humankind",
    "tr": "Ilaahin naas"
  },
  "4": {
    "t": "from the evil of the lurking whisperer—",
    "tr": "Min sharril waswaasil khannaas"
  },
  "5": {
    "t": "who whispers into the hearts of humankind—",
    "tr": "Allazee yuwaswisu fee sudoorin naas"
  },
  "6": {
    "t": "from among jinn and humankind.”",
    "tr": "Minal jinnati wannaas"
  }
}