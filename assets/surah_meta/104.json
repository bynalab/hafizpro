{
  "1": {
    "t": "Woe to every backbiter, slanderer",
    "tr": "Wailul likulli hu-mazatil lumazah"
  },
  "2": {
    "t": "who amasses wealth ˹greedily˺ and counts it ˹repeatedly˺",
    "tr": "Allazee jama'a maalanw Wa-'addadah"
  },
  "3": {
    "t": "thinking that their wealth will make them immortal",
    "tr": "Yahsabu anna maalahooo akhladah"
  },
  "4": {
    "t": "Not at all! Such a person will certainly be tossed into the Crusher",
    "tr": "Kallaa; layumbazanna fil hutamah"
  },
  "5": {
    "t": "And what will make you realize what the Crusher is",
    "tr": "Wa-maa adraaka mal hutamah"
  },
  "6": {
    "t": "˹It is˺ Allah’s kindled Fire",
    "tr": "Naarul laahil mooqada"
  },
  "7": {
    "t": "which rages over the hearts",
    "tr": "Allatee tattali'u 'alal af'idah"
  },
  "8": {
    "t": "It will be sealed over them",
    "tr": "Innahaa 'alaihim mu'sada"
  },
  "9": {
    "t": "˹tightly secured˺ with long braces",
    "tr": "Fee 'amadim mumaddadah"
  }
}