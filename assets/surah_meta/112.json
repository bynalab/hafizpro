{
  "1": {
    "t": "Say, ˹O Prophet,˺ “He is Allah—One ˹and Indivisible˺",
    "tr": "Qul huwal laahu ahad"
  },
  "2": {
    "t": "Allah—the Sustainer ˹needed by all˺",
    "tr": "Allah-hus samad"
  },
  "3": {
    "t": "He has never had offspring, nor was He born",
    "tr": "Lam yalid Wa-lam yoolad"
  },
  "4": {
    "t": "And there is none comparable to Him.”",
    "tr": "Wa-lam yakul lahoo kufuwan ahad"
  }
}